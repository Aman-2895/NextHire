# ==========================================
# NextHire Backend - Environment Variables
# Copy this file to ".env" and fill in your real values
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:  mongodb://127.0.0.1:27017/nexthire
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexthire
MONGO_URI=mongodb://127.0.0.1:27017/nexthire

# JWT Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google Gemini AI
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_here        

# CORS - your deployed / local frontend URL
CLIENT_URL=http://localhost:5173

# File upload limits (in MB)
MAX_UPLOAD_SIZE_MB=5
